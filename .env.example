# Copy to .env.local for local dev, and add the same keys in the Vercel project
# settings for production. Neither file should ever be committed.

# Contact form and newsletter both go through Resend: https://resend.com
# The key is the same one the Salmonberry Studios site uses.
RESEND_API_KEY=
# Optional. Where contact messages go (defaults to site.email in site.config.ts).
CONTACT_TO_EMAIL=
# Optional. The sender. Must be on a domain verified in Resend.
CONTACT_FROM_EMAIL="Benjamin Hazel website <website@salmonberrystudios.com>"
