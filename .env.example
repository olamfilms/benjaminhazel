# Copy to .env.local for local dev, and add the same keys in the Vercel project
# settings for production. Neither file should ever be committed.

# Newsletter, via Kit. See app/api/subscribe/route.ts.
# Kit dashboard -> Settings -> Advanced -> API
KIT_API_KEY=
KIT_FORM_ID=

# The contact form goes through Formspree, which needs no key.
# Its endpoint URL lives in site.config.ts.
